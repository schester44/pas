/// A tenant's subscription of public event types to a destination (PLAN §15.8).
model EventSubscription {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id")
  kind           String
  name           String
  url            String?
  eventTypes     String[]  @map("event_types")
  filter         String?
  status         String
  disabledReason String?   @map("disabled_reason")
  secrets        Json
  secretHint     String?   @map("secret_hint")
  failingSince   DateTime? @map("failing_since") @db.Timestamptz(6)
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@map("event_subscriptions")
}

/// A published public event: the exact envelope every destination receives.
model OutboundEvent {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id")
  type          String
  sourceEventId String   @map("source_event_id")
  environment   String
  test          Boolean  @default(false)
  subjectKind   String?  @map("subject_kind")
  subjectId     String?  @map("subject_id")
  envelope      Json     @db.Json
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceEventId, type])
  @@index([tenantId, occurredAt])
  @@map("outbound_events")
}

model EventDelivery {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  status         String
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lastStatusCode Int?      @map("last_status_code")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)

  @@unique([subscriptionId, eventId])
  @@index([tenantId, subscriptionId, createdAt])
  @@map("event_deliveries")
}

model EventDeliveryAttempt {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id")
  deliveryId   String   @map("delivery_id") @db.Uuid
  attempt      Int
  trigger      String
  request      Json
  statusCode   Int?     @map("status_code")
  responseBody String?  @map("response_body")
  error        String?
  durationMs   Int      @map("duration_ms")
  attemptedAt  DateTime @map("attempted_at") @db.Timestamptz(6)

  @@index([tenantId, deliveryId, attempt])
  @@map("event_delivery_attempts")
}

/// One user's in-app feed entry.
model Notification {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  eventId     String    @map("event_id") @db.Uuid
  eventType   String    @map("event_type")
  title       String
  body        String
  subjectKind String?   @map("subject_kind")
  subjectId   String?   @map("subject_id")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, userId, eventId])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

/// Which event types a user gets in app. No row means the defaults for their audience.
model NotificationPreference {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  eventTypes String[] @map("event_types")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, userId])
  @@map("notification_preferences")
}
