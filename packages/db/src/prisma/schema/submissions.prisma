enum SubmissionStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN

  @@map("submission_status")
}

/// Pinned to the product release it was started on; never re-resolved (CLAUDE.md rule 5).
model Submission {
  id               String           @id @db.Uuid
  tenantId         String           @map("tenant_id")
  number           String
  productId        String           @map("product_id") @db.Uuid
  productReleaseId String           @map("product_release_id") @db.Uuid
  productVersionId String           @map("product_version_id") @db.Uuid
  productVersion   String           @map("product_version")
  formKey          String           @map("form_key")
  country          String           @db.Char(2)
  subdivision      String?          @db.VarChar(6)
  effectiveDate    DateTime         @map("effective_date") @db.Date
  channel          String
  stage            String
  producerId       String           @map("producer_id")
  producerName     String           @map("producer_name")
  agencyId         String?          @map("agency_id") @db.Uuid
  insuredName      String?          @map("insured_name")
  riskData         Json             @map("risk_data")
  status           SubmissionStatus @default(DRAFT)
  createdAt        DateTime         @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @map("updated_at") @db.Timestamptz(6)
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(6)
  withdrawnAt      DateTime?        @map("withdrawn_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@index([tenantId, updatedAt])
  @@index([tenantId, producerId, updatedAt])
  @@index([tenantId, agencyId, updatedAt])
  @@index([tenantId, status, updatedAt])
  @@index([insuredName(ops: raw("gin_trgm_ops"))], type: Gin, map: "submissions_insured_name_trgm")
  @@index([number(ops: raw("gin_trgm_ops"))], type: Gin, map: "submissions_number_trgm")
  @@map("submissions")
}

model SubmissionSequence {
  tenantId  String @id @map("tenant_id")
  lastValue Int    @map("last_value")

  @@map("submission_sequences")
}

enum QuoteStatus {
  QUOTED
  REFERRED
  DECLINED
  EXPIRED
  BOUND

  @@map("quote_status")
}

/// The priced offer for a submission (PLAN §7.2). Pinned to the submission's release.
model Quote {
  id               String      @id @db.Uuid
  tenantId         String      @map("tenant_id")
  submissionId     String      @map("submission_id") @db.Uuid
  submissionNumber String      @map("submission_number")
  productReleaseId String      @map("product_release_id") @db.Uuid
  revision         Int
  status           QuoteStatus
  currency         String      @db.Char(3)
  premium          Decimal     @db.Decimal(18, 2)
  taxesAndFees     Decimal     @map("taxes_and_fees") @db.Decimal(18, 2)
  total            Decimal     @db.Decimal(18, 2)
  termStart        DateTime    @map("term_start") @db.Date
  termEnd          DateTime    @map("term_end") @db.Date
  riskData         Json        @map("risk_data")
  selection        Json
  evaluation       Json
  referral         Json?
  details          Json?
  signature        Json?
  payment          Json?
  payPlan          String?     @map("pay_plan")
  policyId         String?     @map("policy_id") @db.Uuid
  policyNumber     String?     @map("policy_number")
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @map("updated_at") @db.Timestamptz(6)
  boundAt          DateTime?   @map("bound_at") @db.Timestamptz(6)

  @@unique([tenantId, submissionId])
  @@index([tenantId, status, updatedAt])
  @@map("quotes")
}

/// One attempt to pay for a quote through the PaymentGateway. Card data never lands here.
model QuotePayment {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  quoteId     String   @map("quote_id") @db.Uuid
  provider    String
  providerRef String?  @map("provider_ref")
  status      String
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @db.Char(3)
  method      Json
  failure     String?
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, quoteId, createdAt])
  @@map("quote_payments")
}

/// What happened to a quote before bind; copied onto the policy's timeline when it binds.
model QuoteActivity {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  quoteId    String   @map("quote_id") @db.Uuid
  type       String
  category   String
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  actor      Json
  summary    String
  data       Json

  @@index([tenantId, quoteId, occurredAt])
  @@map("quote_activity")
}

/// A link the producer sent so the insured completes their part of the application (disclosures,
/// signature, payment). The token is an HMAC of the id, so nothing secret is stored here.
model QuoteClientRequest {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id")
  quoteId          String    @map("quote_id") @db.Uuid
  submissionId     String    @map("submission_id") @db.Uuid
  submissionNumber String    @map("submission_number")
  producerId       String    @map("producer_id")
  email            String
  name             String
  sentByUserId     String?   @map("sent_by_user_id")
  sentByName       String    @map("sent_by_name")
  sentAt           DateTime  @map("sent_at") @db.Timestamptz(6)
  openedAt         DateTime? @map("opened_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, quoteId, createdAt])
  @@map("quote_client_requests")
}

/// One enrichment stage as it ran for a submission (PLAN §11.1). Append-only: a trigger rejects updates.
model EnrichmentRecord {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id")
  submissionId     String   @map("submission_id") @db.Uuid
  productReleaseId String   @map("product_release_id") @db.Uuid
  stage            String
  inputHash        String   @map("input_hash")
  snapshot         Json
  prefills         Json
  discrepancies    Json
  calls            Json
  reports          Json
  missingReports   Json     @map("missing_reports")
  blocked          Json?
  takenAt          DateTime @map("taken_at") @db.Timestamptz(6)

  @@index([tenantId, submissionId, stage, takenAt])
  @@map("enrichment_records")
}
