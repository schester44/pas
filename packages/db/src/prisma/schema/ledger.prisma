/// The native billing system's chart of accounts, seeded per tenant from the template.
model LedgerAccount {
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  type      String
  role      String
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, code])
  @@unique([tenantId, role])
  @@map("ledger_accounts")
}

/// One immutable, balanced journal entry. Corrections are reversing entries; never updated or deleted.
model LedgerEntry {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id")
  number         Int
  idempotencyKey String   @map("idempotency_key")
  kind           String
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  effectiveOn    DateTime @map("effective_on") @db.Date
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(6)
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  actorName      String   @map("actor_name")
  memo           String
  reversesId     String?  @unique @map("reverses_id") @db.Uuid
  billingEventId String?  @map("billing_event_id")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, number])
  @@index([tenantId, recordedAt])
  @@index([tenantId, sourceType, sourceId])
  @@map("ledger_entries")
}

/// A signed line of a journal entry: positive debits, negative credits, with reporting dimensions.
model LedgerLine {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id")
  entryId      String   @map("entry_id") @db.Uuid
  position     Int
  accountCode  String   @map("account_code")
  currency     String   @db.Char(3)
  amount       Decimal  @db.Decimal(18, 2)
  effectiveOn  DateTime @map("effective_on") @db.Date
  payerType    String?  @map("payer_type")
  payerRef     String?  @map("payer_ref")
  policyId     String?  @map("policy_id") @db.Uuid
  invoiceId    String?  @map("invoice_id") @db.Uuid
  paymentId    String?  @map("payment_id") @db.Uuid
  agencyId     String?  @map("agency_id")
  jurisdiction String?

  @@index([tenantId, accountCode, effectiveOn])
  @@index([tenantId, invoiceId])
  @@index([tenantId, policyId])
  @@index([tenantId, paymentId])
  @@index([tenantId, entryId])
  @@map("ledger_lines")
}

/// Cached balance per account and currency; `version` increments on every posting.
model LedgerBalance {
  tenantId    String   @map("tenant_id")
  accountCode String   @map("account_code")
  currency    String   @db.Char(3)
  balance     Decimal  @db.Decimal(18, 2)
  version     Int
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, accountCode, currency])
  @@map("ledger_balances")
}

model LedgerSequence {
  tenantId  String @map("tenant_id")
  kind      String
  lastValue Int    @map("last_value")

  @@id([tenantId, kind])
  @@map("ledger_sequences")
}

/// What PAS billed, as the ledger learned it from PAS's outbound billing facts.
model LedgerReceivable {
  tenantId        String   @map("tenant_id")
  invoiceId       String   @map("invoice_id") @db.Uuid
  number          String
  kind            String
  policyId        String   @map("policy_id") @db.Uuid
  policyNumber    String   @map("policy_number")
  payerType       String   @map("payer_type")
  payerRef        String?  @map("payer_ref")
  payerName       String?  @map("payer_name")
  currency        String   @db.Char(3)
  total           Decimal  @db.Decimal(18, 2)
  issuedOn        DateTime @map("issued_on") @db.Date
  dueOn           DateTime @map("due_on") @db.Date
  jurisdiction    String?
  statementId     String?  @map("statement_id") @db.Uuid
  statementNumber String?  @map("statement_number")
  /// When the invoice became a bill; its installment fee is owed (and booked) from then.
  billedOn        DateTime? @map("billed_on") @db.Date
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, invoiceId])
  @@index([tenantId, number])
  @@index([tenantId, policyNumber])
  @@index([tenantId, payerType, payerRef])
  @@index([tenantId, statementNumber])
  @@map("ledger_receivables")
}

/// Money received: by card through the payment provider, or offline (check, wire, ACH push, lockbox).
model LedgerPayment {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id")
  number         String
  rail           String
  payerType      String?   @map("payer_type")
  payerRef       String?   @map("payer_ref")
  payerName      String?   @map("payer_name")
  currency       String    @db.Char(3)
  amount         Decimal   @db.Decimal(18, 2)
  applied        Decimal   @db.Decimal(18, 2)
  refunded       Decimal   @db.Decimal(18, 2)
  receivedOn     DateTime  @map("received_on") @db.Date
  reference      String?
  provider       String?
  providerRef    String?   @map("provider_ref")
  batchId        String?   @map("batch_id") @db.Uuid
  status         String
  reversalReason String?   @map("reversal_reason")
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(6)
  memo           String?
  version        Int
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@index([tenantId, status, receivedOn])
  @@index([tenantId, payerType, payerRef])
  @@index([tenantId, batchId])
  @@index([tenantId, provider, providerRef])
  @@map("ledger_payments")
}

/// Part of a payment applied to one invoice; reversed (never deleted) on unapply or NSF.
model LedgerApplication {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id")
  paymentId   String    @map("payment_id") @db.Uuid
  invoiceId   String    @map("invoice_id") @db.Uuid
  policyId    String    @map("policy_id") @db.Uuid
  statementId String?   @map("statement_id") @db.Uuid
  currency    String    @db.Char(3)
  amount      Decimal   @db.Decimal(18, 2)
  status      String
  eventId     String    @map("event_id")
  appliedAt   DateTime  @map("applied_at") @db.Timestamptz(6)
  reversedAt  DateTime? @map("reversed_at") @db.Timestamptz(6)

  @@unique([tenantId, eventId])
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
  @@map("ledger_applications")
}

model LedgerDepositBatch {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id")
  number      String
  rail        String
  status      String
  depositedOn DateTime? @map("deposited_on") @db.Date
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("ledger_deposit_batches")
}

model LedgerLockboxImport {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  fileName   String   @map("file_name")
  batchId    String   @map("batch_id") @db.Uuid
  rows       Int
  matched    Int
  exceptions Int
  importedAt DateTime @map("imported_at") @db.Timestamptz(6)

  @@index([tenantId, importedAt])
  @@map("ledger_lockbox_imports")
}

/// One lockbox row: matched and applied, or an exception held in unapplied cash until resolved.
model LedgerLockboxItem {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  importId   String   @map("import_id") @db.Uuid
  row        Int
  raw        Json
  currency   String   @db.Char(3)
  amount     Decimal  @db.Decimal(18, 2)
  reference  String?
  matchedBy  String?  @map("matched_by")
  status     String
  reason     String?
  paymentId  String?  @map("payment_id") @db.Uuid
  invoiceId  String?  @map("invoice_id") @db.Uuid
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, importId, row])
  @@index([tenantId, status])
  @@map("ledger_lockbox_items")
}

model LedgerRefund {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  number      String
  source      String
  paymentId   String?  @map("payment_id") @db.Uuid
  invoiceId   String?  @map("invoice_id") @db.Uuid
  payerName   String?  @map("payer_name")
  currency    String   @db.Char(3)
  amount      Decimal  @db.Decimal(18, 2)
  method      String
  status      String
  checkNumber String?  @map("check_number")
  providerRef String?  @map("provider_ref")
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("ledger_refunds")
}

model LedgerWriteOff {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id")
  invoiceId     String   @map("invoice_id") @db.Uuid
  currency      String   @db.Char(3)
  amount        Decimal  @db.Decimal(18, 2)
  reason        String
  status        String
  requestedById String   @map("requested_by_id")
  requestedBy   String   @map("requested_by")
  decidedById   String?  @map("decided_by_id")
  decidedBy     String?  @map("decided_by")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  @@map("ledger_write_offs")
}

model LedgerSettings {
  tenantId             String   @id @map("tenant_id")
  currency             String   @db.Char(3)
  smallBalanceWriteOff Decimal? @map("small_balance_write_off") @db.Decimal(18, 2)
  openedAt             DateTime @map("opened_at") @db.Timestamptz(6)
  /// written once receivables are booked for the full term at issue (adjusting entries posted).
  receivableBasis      String   @default("installment") @map("receivable_basis")
  updatedAt            DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("ledger_settings")
}

/// A mutating command's idempotency key, committed with the command's effects.
model LedgerIdempotencyKey {
  tenantId    String   @map("tenant_id")
  key         String
  action      String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@map("ledger_idempotency_keys")
}

/// Who did what to which ledger record, with before and after. Append-only.
model LedgerAuditEntry {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  actorType      String   @map("actor_type")
  actorId        String?  @map("actor_id")
  actorName      String   @map("actor_name")
  action         String
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  idempotencyKey String?  @map("idempotency_key")

  @@index([tenantId, entityType, entityId, occurredAt], map: "ledger_audit_entity_idx")
  @@index([tenantId, occurredAt])
  @@map("ledger_audit_entries")
}

model LedgerReconciliation {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  asOf        DateTime @map("as_of") @db.Date
  ranAt       DateTime @map("ran_at") @db.Timestamptz(6)
  status      String
  ledgerTotal Decimal  @map("ledger_total") @db.Decimal(18, 2)
  pasTotal    Decimal  @map("pas_total") @db.Decimal(18, 2)
  currency    String   @db.Char(3)
  invoices    Int
  differences Json
  cacheDrift  Json     @map("cache_drift")

  @@index([tenantId, ranAt])
  @@map("ledger_reconciliations")
}

/// Commission recorded on a financial transaction, and when it becomes payable to the agency.
model LedgerCommission {
  tenantId               String   @map("tenant_id")
  financialTransactionId String   @map("financial_transaction_id")
  policyId               String   @map("policy_id") @db.Uuid
  agencyId               String   @map("agency_id")
  currency               String   @db.Char(3)
  amount                 Decimal  @db.Decimal(18, 2)
  basis                  String
  recordedAt             DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([tenantId, financialTransactionId])
  @@index([tenantId, policyId])
  @@map("ledger_commissions")
}
