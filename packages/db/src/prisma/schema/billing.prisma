enum InvoiceStatus {
  SCHEDULED
  OPEN
  PAST_DUE
  PARTIALLY_PAID
  PAID
  VOID

  @@map("invoice_status")
}

/// A bill (or credit note) for one financial policy transaction, or one installment of it (PLAN §13).
model Invoice {
  id               String        @id @db.Uuid
  tenantId         String        @map("tenant_id")
  number           String
  kind             String
  policyId         String        @map("policy_id") @db.Uuid
  policyNumber     String        @map("policy_number")
  transactionId    String        @map("transaction_id") @db.Uuid
  scheduleId       String?       @map("schedule_id") @db.Uuid
  installment      Int           @default(1)
  installments     Int           @default(1)
  payer            String        @default("insured")
  payerRef         String?       @map("payer_ref")
  currency         String        @db.Char(3)
  total            Decimal       @db.Decimal(18, 2)
  amountPaid       Decimal       @map("amount_paid") @db.Decimal(18, 2)
  amountCredited   Decimal       @default(0) @map("amount_credited") @db.Decimal(18, 2)
  amountWrittenOff Decimal       @default(0) @map("amount_written_off") @db.Decimal(18, 2)
  status           InvoiceStatus
  issuedOn         DateTime      @map("issued_on") @db.Date
  dueOn            DateTime      @map("due_on") @db.Date
  createdAt        DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@unique([tenantId, transactionId, installment])
  @@index([tenantId, policyId, createdAt])
  @@index([tenantId, scheduleId])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @db.Uuid
  tenantId      String  @map("tenant_id")
  invoiceId     String  @map("invoice_id") @db.Uuid
  transactionId String? @map("transaction_id") @db.Uuid
  position      Int
  kind          String
  code          String
  label         String
  coverage      String?
  exposure      String?
  amount        Decimal @db.Decimal(18, 2)

  @@index([tenantId, invoiceId, position])
  @@map("invoice_lines")
}

/// Money received and applied to one invoice, or refunded against a credit note (negative).
model Payment {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  policyId    String   @map("policy_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  kind        String   @default("payment")
  provider    String
  providerRef String   @map("provider_ref")
  method      Json
  currency    String   @db.Char(3)
  amount      Decimal  @db.Decimal(18, 2)
  receivedAt  DateTime @map("received_at") @db.Timestamptz(6)

  @@unique([tenantId, provider, providerRef])
  @@index([tenantId, policyId, receivedAt])
  @@map("payments")
}

model InvoiceSequence {
  tenantId  String @id @map("tenant_id")
  lastValue Int    @map("last_value")

  @@map("invoice_sequences")
}

/// One term's installment schedule under a pay plan (PLAN §13); the plan is copied from the release.
model BillingSchedule {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id")
  policyId        String   @map("policy_id") @db.Uuid
  policyNumber    String   @map("policy_number")
  termId          String   @map("term_id") @db.Uuid
  billingMethod   String   @default("direct") @map("billing_method")
  plan            Json
  dunning         Json
  status          String
  paymentMethodId String?  @map("payment_method_id") @db.Uuid
  createdAt       DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, termId])
  @@index([tenantId, policyId])
  @@map("billing_schedules")
}

/// A payment method saved with the payer's consent for autopay; only the provider's reference is kept.
model PaymentMethod {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id")
  policyId    String   @map("policy_id") @db.Uuid
  provider    String
  providerRef String   @map("provider_ref")
  customerRef String?  @map("customer_ref")
  brand       String
  last4       String
  expMonth    Int      @map("exp_month")
  expYear     Int      @map("exp_year")
  consent     Json
  status      String
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, policyId])
  @@map("payment_methods")
}

/// Every money change to an invoice, as a canonical billing event (PLAN §13 "Bring your own billing").
/// Idempotent by (tenant, source, event id); built-in flows and external billing systems both write here.
model BillingEvent {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id")
  source     String
  eventId    String   @map("event_id")
  type       String
  invoiceId  String?  @map("invoice_id") @db.Uuid
  policyId   String?  @map("policy_id") @db.Uuid
  payload    Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  appliedAt  DateTime @map("applied_at") @db.Timestamptz(6)

  @@unique([tenantId, source, eventId])
  @@index([tenantId, policyId, occurredAt])
  @@map("billing_events")
}
