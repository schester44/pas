enum ProductStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("product_status")
}

model Product {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id")
  key            String
  name           String
  lineOfBusiness String        @map("line_of_business")
  status         ProductStatus @default(DRAFT)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @map("updated_at") @db.Timestamptz(6)

  versions ProductVersion[]
  releases ProductRelease[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
  @@map("products")
}

enum ProductVersionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED

  @@map("product_version_status")
}

model ProductVersion {
  id           String               @id @db.Uuid
  tenantId     String               @map("tenant_id")
  productId    String               @map("product_id") @db.Uuid
  version      String
  status       ProductVersionStatus @default(DRAFT)
  riskSchema   Json                 @map("risk_schema")
  forms        Json
  coverages    Json
  availability Json
  lifecycle    Json
  documents    Json                 @default("{\"templates\": [], \"clauses\": [], \"schedule\": []}")
  rules        Json                 @default("[]")
  rating       Json?
  billing      Json                 @default("{\"payPlans\": []}")
  basedOnId    String?              @map("based_on_id") @db.Uuid
  createdAt    DateTime             @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @map("updated_at") @db.Timestamptz(6)
  publishedAt  DateTime?            @map("published_at") @db.Timestamptz(6)
  retiredAt    DateTime?            @map("retired_at") @db.Timestamptz(6)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  releases ProductRelease[]

  @@unique([productId, version])
  @@index([tenantId, productId, status])
  @@map("product_versions")
}

/// Immutable: a trigger rejects updates (see the product_versions migration).
model ProductRelease {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id")
  productId        String    @map("product_id") @db.Uuid
  productVersionId String    @map("product_version_id") @db.Uuid
  version          String
  country          String    @db.Char(2)
  subdivision      String?   @db.VarChar(6)
  newBusinessFrom  DateTime  @map("new_business_from") @db.Date
  newBusinessTo    DateTime? @map("new_business_to") @db.Date
  renewalFrom      DateTime  @map("renewal_from") @db.Date
  renewalTo        DateTime? @map("renewal_to") @db.Date
  manifest         Json
  contentHash      String    @map("content_hash") @db.Char(64)
  publishedAt      DateTime  @map("published_at") @db.Timestamptz(6)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVersion ProductVersion @relation(fields: [productVersionId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, country, subdivision, newBusinessFrom])
  @@index([tenantId, productId, country, subdivision, renewalFrom])
  @@index([productVersionId])
  @@map("product_releases")
}
