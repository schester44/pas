{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "PORT", "DATABASE_URL", "LOG_LEVEL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@pas/db#generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["@pas/db#generate"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["@pas/db#generate"],
      "outputs": []
    },
    "generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    }
  }
}
