NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pas

# Deployed envs: superusers and table owners bypass RLS, so api/worker connect as the non-owner
# `pas_app` role (DATABASE_URL=postgresql://pas_app:...@host/pas). Migrations, the pg-boss schema
# install and `pnpm db:app-role` run as the owner role via DATABASE_URL_OWNER.
# Local dev can keep DATABASE_URL as the owner and leave these unset.
# DATABASE_URL_OWNER=postgresql://postgres:postgres@localhost:5432/pas
# PAS_APP_PASSWORD=change-me

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# Origins allowed to call the API (comma separated)
ADMIN_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5174

API_PORT=4000

# Storage
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=.storage
# STORAGE_DRIVER=s3 (AWS S3, or MinIO / R2 via S3_ENDPOINT). Omit the keys to use the AWS
# default credential chain (IAM role, profile).
# S3_BUCKET=pas-documents
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# pg-boss and @pas/workflows install their schemas and queues on start in dev. Deployed api/worker
# run as pas_app, so set this to false there and run `pnpm queues:setup` and
# `pnpm workflows:setup` as the owner during deploys.
# PGBOSS_MANAGE_SCHEMA=false
